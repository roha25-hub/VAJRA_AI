# Copy to .env and fill in. Never commit .env.
# All providers are free-tier. Only two are strictly required to start.

GEMINI_API_KEY=
GROQ_API_KEY=

# Alerts (optional). Twilio: trial = ~$15 credit, only verified numbers.
# ElevenLabs: free tier = 10k chars/month.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=        # e.g. +15551234567 — the Twilio number
ALERT_TO=           # e.g. +91XXXXXXXXXX — your verified phone
ELEVENLABS_KEY=
ELEVENLABS_VOICE=Rachel

# Optional backups
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=
CEREBRAS_API_KEY=

# Local fallback (optional)
OLLAMA_HOST=http://127.0.0.1:11434

# Supabase (free tier: Postgres + Realtime)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Harness
AEGIS_RUN_MODE=live        # live | replay
AEGIS_CACHE_PATH=llm/cache.sqlite
AEGIS_TRACE_DIR=data/traces
